{
  "name": "exzihub",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "release": "tauri build --no-bundle && node scripts/copier-exe.cjs",
    "publier": "npm run release && node scripts/publier-hub.cjs",
    "publier-apk": "node scripts/publier-apk.cjs",
    "installer": "tauri build --bundles nsis && node scripts/copier-installer.cjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
