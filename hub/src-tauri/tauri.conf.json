{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExziHub",
  "version": "0.4.4",
  "identifier": "com.exzitech.exzihub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ExziHub",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../installer/tools.json": "tools.json",
      "../hub.json": "hub.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
